<resources>
    <!-- Exercise catalog -->
    <string name="ex_hint_pushups">Back straight, chest almost touches the floor. On knees counts too.</string>
    <string name="ex_dips">Triceps dips</string>
    <string name="ex_hint_dips">Hands on the edge of a chair behind you, elbows back.</string>
    <string name="ex_pullups">Pull-ups</string>
    <string name="ex_hint_pullups">You need a bar. If you cannot pull up yet, lower yourself slowly from the top, that counts too.</string>
    <string name="ex_superman">Superman</string>
    <string name="ex_hint_superman">Lying face down, lift your arms and legs, keep your neck neutral.</string>
    <string name="ex_hinge">Hip hinge</string>
    <string name="ex_hint_hinge">Knees slightly bent, back straight, hips back. You feel it in the back of the thighs.</string>
    <string name="ex_hint_squats">Heels on the floor, knees point the same way as your toes.</string>
    <string name="ex_jump_squat">Jump squats</string>
    <string name="ex_hint_jump_squat">Squat and jump up, land softly on your toes, keep your knees apart.</string>
    <string name="ex_lunges">Lunges</string>
    <string name="ex_hint_lunges">Reps count for each leg. Knee over the foot.</string>
    <string name="ex_step_up">Step-ups</string>
    <string name="ex_hint_step_up">Use a stable chair or step, go up and down. Reps count for each leg.</string>
    <string name="ex_bridge">Glute bridge</string>
    <string name="ex_hint_bridge">Lying on your back, lift your hips and squeeze your glutes.</string>
    <string name="ex_calf_raise">Calf raises</string>
    <string name="ex_hint_calf_raise">Rise onto your toes, pause at the top, lower slowly.</string>
    <string name="ex_wall_sit">Wall sit</string>
    <string name="ex_hint_wall_sit">Back against the wall, knees at a right angle. Counted in seconds.</string>
    <string name="ex_donkey_kick">Donkey kicks</string>
    <string name="ex_hint_donkey_kick">On all fours, knee bent, heel to the ceiling. Reps count for each leg.</string>
    <string name="ex_hint_crunches">Lower back on the floor, do not pull your neck with your hands.</string>
    <string name="ex_bicycle">Bicycle crunches</string>
    <string name="ex_hint_bicycle">Elbow to the opposite knee is one rep.</string>
    <string name="ex_leg_raise">Lying leg raises</string>
    <string name="ex_hint_leg_raise">Lying on your back, lift straight legs, keep your lower back on the floor.</string>
    <string name="ex_flutter">Flutter kicks</string>
    <string name="ex_hint_flutter">Lying on your back, straight legs go up and down in turn, lower back on the floor.</string>
    <string name="ex_hint_plank">Your body is a straight line from shoulders to heels.</string>
    <string name="ex_side_plank">Side plank</string>
    <string name="ex_hint_side_plank">Seconds on each side. Do not let your hips sag.</string>
    <string name="ex_bird_dog">Bird dog</string>
    <string name="ex_hint_bird_dog">On all fours, reach one arm and the opposite leg out, keep your back flat.</string>
    <string name="ex_burpee">Burpees</string>
    <string name="ex_hint_burpee">Squat, plank, squat, jump. You can skip the jump.</string>
    <string name="ex_jacks">Jumping jacks</string>
    <string name="ex_hint_jacks">Land softly on your toes, arms overhead.</string>
    <string name="ex_mountain">Mountain climbers</string>
    <string name="ex_hint_mountain">Hands under shoulders, knees to chest in turn. Keep your back flat.</string>
    <string name="ex_high_knees">High knees</string>
    <string name="ex_hint_high_knees">In place, knees to hip height, land softly on your toes.</string>
