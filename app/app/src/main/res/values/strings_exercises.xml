    <!-- Каталог упражнений (Р75) -->
    <string name="ex_hint_pushups">Спина ровная, грудь почти касается пола. С колен — тоже считается.</string>
    <string name="ex_dips">Обратные отжимания</string>
    <string name="ex_hint_dips">Руки на краю стула за спиной, локти назад.</string>
    <string name="ex_pullups">Подтягивания</string>
    <string name="ex_hint_pullups">Нужен турник. Если пока не выходит — медленно опускайтесь из верхней точки, это тоже повтор.</string>
    <string name="ex_superman">Лодочка</string>
    <string name="ex_hint_superman">Лёжа на животе, поднимайте руки и ноги, шею не запрокидываем.</string>
    <string name="ex_hinge">Наклон с прямой спиной</string>
    <string name="ex_hint_hinge">Колени чуть согнуты, спина прямая, таз назад. Тянет заднюю поверхность бёдер.</string>
    <string name="ex_hint_squats">Пятки на полу, колени смотрят туда же, куда носки.</string>
    <string name="ex_jump_squat">Прыжки из приседа</string>
    <string name="ex_hint_jump_squat">Присед и прыжок вверх, приземление мягко на носки, колени не сводим.</string>
    <string name="ex_lunges">Выпады</string>
    <string name="ex_hint_lunges">Считаются повторы на каждую ногу. Колено над стопой.</string>
    <string name="ex_step_up">Подъём на ступень</string>
    <string name="ex_hint_step_up">Устойчивый стул или ступенька, поднимайтесь и спускайтесь. Повторы на каждую ногу.</string>
    <string name="ex_bridge">Ягодичный мост</string>
    <string name="ex_hint_bridge">Лёжа на спине, поднимайте таз, сжимая ягодицы.</string>
    <string name="ex_calf_raise">Подъём на носки</string>
    <string name="ex_hint_calf_raise">Поднимайтесь на носки, наверху пауза, медленно вниз.</string>
    <string name="ex_wall_sit">Стульчик у стены</string>
    <string name="ex_hint_wall_sit">Спина прижата к стене, колени под прямым углом. Считаем секунды.</string>
    <string name="ex_donkey_kick">Мах ногой на четвереньках</string>
    <string name="ex_hint_donkey_kick">На четвереньках, колено согнуто, пятка к потолку. Повторы на каждую ногу.</string>
    <string name="ex_hint_crunches">Поясница прижата к полу, шею не тянем руками.</string>
    <string name="ex_bicycle">Пресс: велосипед</string>
    <string name="ex_hint_bicycle">Локоть к противоположному колену — один повтор.</string>
    <string name="ex_leg_raise">Подъём ног лёжа</string>
    <string name="ex_hint_leg_raise">Лёжа на спине, поднимайте прямые ноги, поясница прижата к полу.</string>
    <string name="ex_flutter">Ножницы лёжа</string>
    <string name="ex_hint_flutter">Лёжа на спине, прямые ноги по очереди вверх и вниз, поясница прижата.</string>
    <string name="ex_hint_plank">Тело — прямая линия от плеч до пяток.</string>
    <string name="ex_side_plank">Боковая планка</string>
    <string name="ex_hint_side_plank">Секунды на каждую сторону. Таз не проваливается.</string>
    <string name="ex_bird_dog">Птица-собака</string>
    <string name="ex_hint_bird_dog">На четвереньках, вытяните руку и противоположную ногу, спина ровная.</string>
    <string name="ex_burpee">Берпи</string>
    <string name="ex_hint_burpee">Присед, упор лёжа, присед, прыжок. Можно без прыжка.</string>
    <string name="ex_jacks">Прыжки «звёздочка»</string>
    <string name="ex_hint_jacks">Мягко на носки, руки над головой.</string>
    <string name="ex_mountain">Альпинист</string>
